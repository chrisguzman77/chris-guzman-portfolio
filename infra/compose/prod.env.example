# Every variable the production stack reads, with dummy values.
# Real values live only in the sops-encrypted prod.enc.env (edit with `make secrets-edit`).
# CI validates compose.yaml against this file.

# Not stored in prod.enc.env (set by scripts/deploy.sh or defaulted in compose.yaml)
IMAGE_TAG=latest
DOCKER_GID=999
GITHUB_RUNNER_REPO=chrisguzman77/chris-guzman-portfolio

# Stored in prod.enc.env
POSTGRES_PASSWORD=change-me
DIRECTUS_DB_PASSWORD=change-me
PORTFOLIO_DB_PASSWORD=change-me
UMAMI_DB_PASSWORD=change-me
DIRECTUS_SECRET=change-me
DIRECTUS_ADMIN_EMAIL=owner@example.com
DIRECTUS_ADMIN_PASSWORD=change-me
CLOUDFLARE_TUNNEL_TOKEN=change-me
# Runner PAT; optional once GITHUB_APP_ID / GITHUB_APP_PRIVATE_KEY are set (docs/setup.md, Runner GitHub App).
GITHUB_RUNNER_TOKEN=change-me
DIRECTUS_WEB_TOKEN=change-me
REVALIDATE_SECRET=change-me
RESEND_API_KEY=change-me
TURNSTILE_SECRET_KEY=change-me
TURNSTILE_SITE_KEY=change-me
GITHUB_ACTIVITY_TOKEN=change-me
CONTACT_TO=owner@example.com
GROQ_API_KEY=change-me
DIRECTUS_API_TOKEN=change-me
INTERNAL_API_SECRET=change-me
CHAT_HASH_SALT=change-me
GRAFANA_ADMIN_PASSWORD=change-me
UMAMI_APP_SECRET=change-me
BACKUP_AGE_RECIPIENT=change-me
R2_ACCOUNT_ID=change-me
R2_BUCKET=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
BACKUP_HEARTBEAT_URL=change-me

# Optional in prod.enc.env (empty or absent keeps the feature off; not checked by secrets-check.sh)
UMAMI_WEBSITE_ID=
# Static token of the Directus admin user (User -> Token -> Generate); empty keeps the
# CMS bootstrap on the DIRECTUS_ADMIN_EMAIL / DIRECTUS_ADMIN_PASSWORD login.
DIRECTUS_BOOTSTRAP_TOKEN=
# Runner GitHub App (docs/setup.md, Runner GitHub App). When both are set the runner
# registers with the app instead of GITHUB_RUNNER_TOKEN. The key is the app's PEM on
# one line with each newline written as a literal \n.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
